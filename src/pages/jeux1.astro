---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";

const project = {
  title: "Lethal Company",
  description: "Un jeu d'horreur multijoueur avec des mécaniques innovantes.",
  image: "/header.png",
  details:
    "Lethal Company propose une expérience immersive où la collaboration entre joueurs est essentielle pour survivre. Avec des graphismes captivants et un gameplay dynamique, ce jeu a été conçu pour offrir des sensations fortes et des moments mémorables.",
};
---

<!doctype html>
<html lang="fr">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <style>
      .hover-card {
        transition:
          transform 0.3s ease,
          box-shadow 0.3s ease;
      }
      .hover-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
      }
      .title-animation {
        transition:
          transform 0.3s ease,
          color 0.3s ease;
      }

      .title-animation:hover {
        transform: scale(1.01);
        color: #f30e09; /* Couleur au survol */
      }
    </style>
    <script src="https://cdn.tailwindcss.com"></script>
  </head>
  <body class="bg-stone-200">
    <!-- Navbar -->
    <div class="flex justify-center pt-12">
      <Header />
    </div>

    <main class="container mx-auto max-w-5xl px-6 py-12">
      <!-- Header Section -->
      <header class="text-center mb-12">
        <h1
          class="font-embed text-5xl md:text-[100px] font-bold mb-6 title-animation"
        >
          {project.title}
        </h1>
        <p class="text-lg text-gray-600">{project.description}</p>
        <a
          href="/about"
          class="inline-block mt-8 px-8 py-3 bg-red-500 text-stone-100 font-semibold text-lg rounded-full shadow-lg hover:bg-red-600 hover:text-stone-50 transition"
        >
          Retour à la galerie
        </a>
      </header>

      <!-- Pourquoi ce jeu ? Section -->
      <section class="bg-stone-100 shadow-lg rounded-lg overflow-hidden mb-12">
        <div class="p-8">
          <h2 class="text-3xl font-embed text-stone-700 font-bold mb-4">
            Pourquoi ce jeu ?
          </h2>
          <p class="text-gray-700 text-lg">
            "Lethal Company" se distingue des autres jeux d'horreur multijoueurs
            par son gameplay collaboratif unique et ses mécaniques innovantes.
            Chaque joueur doit compter sur ses coéquipiers pour survivre, et
            l'immersion est renforcée par des graphismes immersifs et une
            ambiance sonore oppressante. Ce jeu ne se contente pas de vous faire
            peur, il vous plonge dans une expérience où la stratégie et
            l’entraide sont essentielles pour triompher.
          </p>
        </div>
      </section>

      <!-- Project Overview Section -->
      <section class="bg-stone-100 shadow-lg rounded-lg overflow-hidden mb-12">
        <img
          src={project.image}
          alt="Aperçu du projet"
          class="w-full h-80 object-cover"
        />
        <div class="p-8">
          <h2 class="text-3xl font-embed text-stone-700 font-bold mb-4">
            Fonctionnement
          </h2>
          <p class="text-gray-700 text-lg">{project.details}</p>
        </div>
      </section>

      <!-- Video Section -->
      <section class="bg-white shadow-lg rounded-lg overflow-hidden mb-12 p-8">
        <h2 class="text-3xl font-bold font-embed text-stone-700 mb-4">
          Regardez ma Vidéo
        </h2>
        <p class="text-stone-700 text-lg mb-6">
          Découvrez ma chaîne YouTube où je partage mes expériences et analyses
          sur le jeu <strong>{project.title}</strong>. Regardez la vidéo
          ci-dessous pour en savoir plus !
        </p>
        <div class="aspect-w-16 aspect-h-9 flex justify-center">
          <iframe
            width="560"
            height="315"
            src="https://www.youtube.com/embed/cTutXN6D2Gg"
            frameborder="0"
            allowfullscreen></iframe>
        </div>
        <div class="text-center mt-6">
          <a
            href="https://www.youtube.com/@sherpuyb"
            target="_blank"
            class="inline-block px-8 py-3 bg-red-500 text-white font-semibold text-lg rounded-full shadow-lg hover:bg-red-600 hover:text-white transition"
          >
            Visitez ma chaîne YouTube
          </a>
        </div>
      </section>
    </main>

    <!-- Footer -->
    <div class="w-full">
      <Footer />
    </div>
  </body>
</html>
